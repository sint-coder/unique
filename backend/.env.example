APP_ENV=development
APP_URL=http://localhost:5173
DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=unique_write;charset=utf8mb4
DB_USER=unique_write
DB_PASS=
SESSION_TTL_DAYS=30
AI_PROVIDER=gemini
# Add keys separated by commas. If one fails, the service tries each other key once.
GEMINI_API_KEYS=
AI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SEC=30
AI_CONNECT_TIMEOUT_SEC=10
AI_DAILY_BUDGET_USD=20
# Gemini 3.5 Flash-Lite standard paid-tier prices, USD per 1M tokens; update if Google changes pricing.
AI_INPUT_USD_PER_1M=0.30
AI_OUTPUT_USD_PER_1M=2.50
APP_KEY=replace-with-a-random-secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STUDENT=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ONE_TIME=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAIL_FROM=support@example.com
MAIL_NAME="Unique Write"
MAIL_DSN=
ADMIN_EMAIL=
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
